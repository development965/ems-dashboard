# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database (MySQL / MariaDB)
DATABASE_URL="mysql://ems_user:change_me@localhost:3306/tm_ems"

# Auth
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Razorpay (payment links for student fees) — leave unset to disable payment
# links; everything else keeps working. Get these from the Razorpay dashboard
# (Settings > API Keys, and Settings > Webhooks for the webhook secret).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Initial super admin (used by prisma/seed.ts)
SEED_COMPANY_NAME="Techmaax"
SEED_COMPANY_SLUG="techmaax"
SEED_SUPER_ADMIN_NAME="Super Admin"
SEED_SUPER_ADMIN_EMAIL="admin@techmaax.com"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"
